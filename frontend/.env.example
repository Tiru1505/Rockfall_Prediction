# Frontend build-time configuration.
#
# Leave this unset for local development — Vite proxies /api to the backend on
# port 8123 (see vite.config.js), so no value is needed.
#
# For the Vercel deployment, set it to the deployed backend INCLUDING the /api
# suffix and with no trailing slash:
#
#   VITE_API_BASE_URL=https://rockfall-api.onrender.com/api
#
# Vite inlines this at build time, so changing it requires a redeploy, not just
# a restart.
VITE_API_BASE_URL=

# ---- Python / backend ----
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# Local SQLite database. Never commit it: it holds real user accounts and
# password hashes, and a committed copy would overwrite nothing useful on
# deploy anyway (bootstrap.py seeds a fresh one on first run).
*.db
*.sqlite
*.sqlite3

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Platform ----
.vercel
.render

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend configuration. Copy to `.env` for local use, or set these as
# environment variables on Render. None are required locally — the defaults
# give you SQLite plus a development signing key.

# Long random string used to sign JWTs. REQUIRED in production: the app refuses
# to start with ROCKFALL_ENV=production while this is still the default.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ROCKFALL_SECRET_KEY=

# Set to "production" on Render to enable the startup safety checks.
ROCKFALL_ENV=development

# Postgres connection string. Render injects DATABASE_URL automatically when the
# service is linked to a database, so you normally leave this blank there.
# `postgres://` URLs are rewritten to `postgresql://` for SQLAlchemy.
ROCKFALL_DATABASE_URL=

# Comma-separated list of allowed frontend origins. Unset means "*".
# e.g. https://rockfall-system.vercel.app
ROCKFALL_CORS_ORIGINS=

# Live monitoring engine
ROCKFALL_MONITORING_AUTOSTART=1
ROCKFALL_MONITORING_INTERVAL=20
